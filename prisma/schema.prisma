generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model QuizResults {
  id          Int      @id @default(autoincrement())
  userId      Int
  clientId    String?  @unique
  title       String?
  mode        QuizMode
  quizType    QuizType
  questionCount Int
  levels       Levels[]
  quizQuestions QuizResultQuestion[]
  timePerQuestion Int
  timeTotalQuiz Int
  scheduleEnabled Boolean
  scheduledOpeningTime DateTime?
  scheduledClosingTime DateTime?
  correctAnswers Int
  scoreInPercent Int
  totalScore  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuizResultQuestion {
  quizResultId Int
  questionId  Int

  quizResult QuizResults @relation(fields: [quizResultId], references: [id], onDelete: Cascade)

  quizQuestion QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizResultId, questionId])
  @@index([questionId])
}

model QuizQuestion {
  id Int @id @default(autoincrement())
  quizType QuizType
  questionText String
  options String[]
  difficultyLevel DifficultyLevels
  answer String
  quizResults QuizResultQuestion[]
  hintWords Word[]
}

model Word {
  id                 Int                 @id @default(autoincrement())
  word               String              @unique
  meaningBn          String[]
  synonyms           String[]
  antonyms           String[]
  definitionEn       String
  definitionBn       String
  examplesEn         String[]
  examplesBn         String[]
  level              Levels
  category           String
  wordType           String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  relatedBy          UserWord[]
  userBookmarks      UserBookmark[]
  quizQuestions      QuizQuestion[]

  @@index([level])
  @@index([category])
}

model UserBookmark {
  userId       Int
  wordId       Int
  bookmarkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId, bookmarkedAt])
}

model UserWord {
  userId    Int
  wordId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  learningStatus LearningStatus @default(LEARNED)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId])
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String?
  user_name          String
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  role               Roles               @default(user)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  lastActivityAt     DateTime?           @default(now())
  password           String?
  accounts           Account[]
  sessions           Session[]
  relatedWords       UserWord[]
  userBookmarks      UserBookmark[]
  quizResults        QuizResults[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Roles {
  user
  admin
}

enum Levels {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LearningStatus {
  LEARNED
  STILL_LEARNING
}

enum QuizMode {
  PRACTICE
  WEEKLY
  BIWEEKLY
}

enum QuizType {
  ENGLISH_TO_BANGLA
  BANGLA_TO_ENGLISH
  SYNONYMS
  ANTONYMS
  MIXED
  IDIOMS_AND_PHRASES
  PREPOSITIONS
  TRUE_FALSE
}

enum DifficultyLevels {
  EASY
  MEDIUM
  HARD
}