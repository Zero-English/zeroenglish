generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
} 

model GrammarRules {
  id Int @id @default(autoincrement())
  title String
  description String
  grammarCategoryId Int
  grammarCategory QuizType @relation(fields: [grammarCategoryId], references: [id], onDelete: Cascade)
  level Levels
  prerequisites GrammarRules[] @relation("GrammarPrerequisites")
  prerequisitesFor GrammarRules[] @relation("GrammarPrerequisites")
  examples String[]
  status grammarRuleStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdByUserId Int
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  commonMistakes String[]
}

model Blog {
  id              Int      @id @default(autoincrement())
  titleEn         String
  titleBn         String
  descriptionEn   String
  descriptionBn   String
  metaTitle       String
  metaDescription String
  slug            String   @unique
  keywords        String[]
  contentEn       String
  contentBn       String
  featuredMediaId Int?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  featuredMedia Media? @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)

  @@index([featuredMediaId])
  @@index([published, createdAt])
}

model Media {
  id        Int      @id @default(autoincrement())
  fileId    String   @unique
  url       String
  name      String
  filePath  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  altText   String   @default("")
  caption   String   @default("")
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogs Blog[]
  popupLandscape Popup[] @relation("PopupLandscape")
  popupPortrait  Popup[] @relation("PopupPortrait")
  templates      VisualTemplate[] @relation("TemplateBackground")

  @@index([createdAt])
}

model Popup {
  id                   Int      @id @default(autoincrement())
  name                 String
  active               Boolean  @default(true)
  link                 String   @default("")
  landscapeMediaId     Int?
  portraitMediaId      Int?
  scheduleEnabled      Boolean  @default(false)
  scheduledOpeningTime DateTime?
  scheduledClosingTime DateTime?
  audience             String   @default("ALL")
  pageRule             String   @default("ALL")
  includePaths         String[] @default([])
  animation            String   @default("FADE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  landscapeMedia Media? @relation("PopupLandscape", fields: [landscapeMediaId], references: [id], onDelete: SetNull)
  portraitMedia  Media? @relation("PopupPortrait", fields: [portraitMediaId], references: [id], onDelete: SetNull)

  @@index([landscapeMediaId])
  @@index([portraitMediaId])
  @@index([active, scheduleEnabled])
}

model QuizExam {
  id                   Int                @id @default(autoincrement())
  title                String
  mode                 QuizMode
  questionCount        Int
  levels               Levels[]
  quizQuestions        QuizExamQuestion[]
  timePerQuestion      Int
  scheduleEnabled      Boolean            @default(false)
  scheduledOpeningTime DateTime?
  scheduledClosingTime DateTime?
  resultsPublished     Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  combinedExamResults CombinedExamResult[]
}

model CombinedExamResult {
  id Int @id @default(autoincrement())
  userId Int
  correctWords Word[] @relation("CombinedExamCorrectWords")
  incorrectWords Word[] @relation("CombinedExamIncorrectWords")
  correctQuestions QuizQuestion[] @relation("CombinedExamCorrectQuestions")
  incorrectQuestions QuizQuestion[] @relation("CombinedExamIncorrectQuestions")
  questionCount Int
  correctAnswers Int
  scoreInPercent Int
  totalScore Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  levels Levels[]
  timePerQuestion Int
  quizTypeId Int
  examId Int?
  clientId String?
  exam QuizExam? @relation(fields: [examId], references: [id], onDelete: SetNull)
  title String
  mode QuizMode
  timeTotalQuiz Int
  scheduleEnabled        Boolean    @default(false)
  scheduledOpeningTime   DateTime?
  scheduledClosingTime   DateTime?
  status                 QuizResultStatus @default(SUBMITTED)
  isFirstAttempt         Boolean          @default(true)

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)
  quizType QuizType @relation(references: [id], fields: [quizTypeId], onDelete: Cascade)
}

model QuizExamQuestion {
  quizExamId Int
  questionId Int

  quizExam QuizExam @relation(fields: [quizExamId], references: [id], onDelete: Cascade)

  quizQuestion QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizExamId, questionId])
  @@index([questionId])
}

model QuizQuestion {
  id              Int                @id @default(autoincrement())
  quizType        QuizType           @relation(fields: [quizTypeId], references: [id], onDelete: Cascade)
  quizTypeId      Int
  questionText    String
  options         String[]
  difficultyLevel DifficultyLevels
  answer          String
  isPending       Boolean @default(true)
  quizExams       QuizExamQuestion[]
  class           Class[]
  hintWords       Word[]
  explanation     String @default("")
  addedByUserId   Int
  addedBy         User @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)
  relaventCombinedExamCorrectQuestions CombinedExamResult[] @relation("CombinedExamCorrectQuestions")
  relaventCombinedExamIncorrectQuestions CombinedExamResult[] @relation("CombinedExamIncorrectQuestions")
}

model Word {
  id            Int            @id @default(autoincrement())
  word          String         @unique
  meaningBn     String[]
  synonyms      String[]
  antonyms      String[]
  definitionEn  String
  definitionBn  String
  examplesEn    String[]
  examplesBn    String[]
  level         Levels
  category      String
  wordType      String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  relatedBy     UserWord[]
  userBookmarks UserBookmark[]
  quizQuestions QuizQuestion[]
  relatedCombinedExamResultCorrectWords CombinedExamResult[] @relation("CombinedExamCorrectWords")
  relatedCombinedExamResultIncorrectWords CombinedExamResult[] @relation("CombinedExamIncorrectWords")
  isPending Boolean @default(true)
  addedByUserId Int 
  addedByUser User @relation(references: [id], fields: [addedByUserId], onDelete: Cascade)

  @@index([level])
  @@index([category])
}

model UserBookmark {
  userId       Int
  wordId       Int
  bookmarkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId, bookmarkedAt])
}

model UserWord {
  userId         Int
  wordId         Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  learningStatus LearningStatus @default(LEARNED)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId])
}

model User {
  id             Int            @id @default(autoincrement())
  name           String?
  user_name      String
  institutionName String?
  bio            String?
  class          Class?
  gender         Gender   @default(NOT_SET)
  socialLinks    String[]
  location       String?
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  role           Roles          @default(user)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  lastActivityAt DateTime?      @default(now())
  password       String?
  accounts       Account[]
  sessions       Session[]
  relatedWords   UserWord[]
  userBookmarks  UserBookmark[]
  isPending      Boolean @default(true)
  addedQuestions QuizQuestion[]
  addedWords Word[]
  addedGrammarRules GrammarRules[]
  relatedCombinedExamResults CombinedExamResult[]
  createdTemplates VisualTemplate[] @relation("CreatedTemplates")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model QuizType {
  id               Int            @id @default(autoincrement())
  name             String         @unique
  relatedQuestions QuizQuestion[]
  relatedGrammarRules GrammarRules[]
  combinedExamResults CombinedExamResult[]
}

model VocabMeta {
  id        Int      @id @default(1)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

enum Roles {
  user
  admin
  contributor
}

enum Levels {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LearningStatus {
  LEARNED
  STILL_LEARNING
}

enum QuizMode {
  PRACTICE
  WEEKLY
  BIWEEKLY
}

enum QuizResultStatus {
  SUBMITTED
  LATE_SUBMITTED
  ABANDONED
  REATTEMPTED
}

enum DifficultyLevels {
  EASY
  MEDIUM
  HARD
}

enum Class {
  PrePrimary
  Class1
  Class2
  Class3
  Class4
  Class5
  Class6
  Class7
  Class8
  SSC
  HSC
  IELTS
  TOEFL
  University
  Masters
  Diploma
  BCS
  JOB
}

enum Gender {
  MALE
  FEMALE
  NOT_SET
}

enum grammarRuleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TemplateType {
  QUIZ_POSTER
  CONTRIBUTOR_CERTIFICATE
  VOCABULARY_POSTER
  LEADERBOARD_POSTER
  ACHIEVEMENT
  COURSE_CERTIFICATE
  EVENT_POSTER
  SOCIAL_POST
  ANNOUNCEMENT
}

model VisualTemplate {
  id                 Int          @id @default(autoincrement())
  name               String
  description        String?      @default("")
  type               TemplateType @default(QUIZ_POSTER)
  width              Int          @default(1080)
  height             Int          @default(1350)
  isDefault          Boolean      @default(false)
  isActive           Boolean      @default(true)
  elements           Json         @default("[]")
  backgroundMediaId  Int?
  backgroundMedia    Media?       @relation("TemplateBackground", fields: [backgroundMediaId], references: [id], onDelete: SetNull)
  backgroundColor    String?      @default("#ffffff")
  createdById        Int?
  createdBy          User?        @relation("CreatedTemplates", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([type, isActive])
  @@index([backgroundMediaId])
}

model EmailConfig {
  id         Int      @id @default(1)
  smtpHost   String   @default("smtp.gmail.com")
  smtpPort   Int      @default(465)
  smtpUser   String   @default("")
  smtpPass   String   @default("")
  smtpSecure Boolean  @default(true)
  fromName   String   @default("Zero English")
  fromEmail  String   @default("")
  replyTo    String?  @default("")
  isEnabled  Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model EmailTemplate {
  id                 Int      @id @default(autoincrement())
  key                String   @unique
  name               String
  description        String?  @default("")
  subject            String
  bodyHtml           String
  bodyText           String?  @default("")
  variables          String[] @default([])
  isActive           Boolean  @default(true)
  autoTriggerEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([key, isActive])
}

enum EmailStatus {
  SENT
  FAILED
  PENDING
}

model EmailLog {
  id              Int         @id @default(autoincrement())
  recipientEmail  String
  recipientUserId Int?
  templateKey     String?
  subject         String
  status          EmailStatus @default(SENT)
  errorMessage    String?
  metadata        Json?       @default("{}")
  sentAt          DateTime    @default(now())

  @@index([recipientEmail])
  @@index([status, sentAt])
  @@index([templateKey])
}
