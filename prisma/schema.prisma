generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Blog {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  metaTitle       String
  metaDescription String
  slug            String   @unique
  keywords        String[]
  content         String
  media           String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QuizExam {
  id                   Int                @id @default(autoincrement())
  title                String
  mode                 QuizMode
  questionCount        Int
  levels               Levels[]
  quizQuestions        QuizExamQuestion[]
  timePerQuestion      Int
  scheduleEnabled      Boolean            @default(false)
  scheduledOpeningTime DateTime?
  scheduledClosingTime DateTime?
  resultsPublished     Boolean            @default(false)
  results              QuizResults[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model QuizResults {
  id                     Int        @id @default(autoincrement())
  userId                 Int
  examId                 Int?
  clientId               String?
  title                  String
  mode                   QuizMode
  quizTypeId             Int
  questionCount          Int
  levels                 Levels[]
  timePerQuestion        Int
  timeTotalQuiz          Int
  scheduleEnabled        Boolean    @default(false)
  scheduledOpeningTime   DateTime?
  scheduledClosingTime   DateTime?
  correctAnswers         Int
  scoreInPercent         Int
  totalScore             Int
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     QuizExam? @relation(fields: [examId], references: [id], onDelete: SetNull)
  quizType QuizType  @relation(fields: [quizTypeId], references: [id])

  @@index([userId, examId])
  @@index([quizTypeId])
}

model QuizExamQuestion {
  quizExamId Int
  questionId Int

  quizExam QuizExam @relation(fields: [quizExamId], references: [id], onDelete: Cascade)

  quizQuestion QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizExamId, questionId])
  @@index([questionId])
}

model QuizQuestion {
  id              Int                @id @default(autoincrement())
  quizType        QuizType           @relation(fields: [quizTypeId], references: [id], onDelete: Cascade)
  quizTypeId      Int
  questionText    String
  options         String[]
  difficultyLevel DifficultyLevels
  answer          String
  quizExams       QuizExamQuestion[]
  hintWords       Word[]
}

model Word {
  id            Int            @id @default(autoincrement())
  word          String         @unique
  meaningBn     String[]
  synonyms      String[]
  antonyms      String[]
  definitionEn  String
  definitionBn  String
  examplesEn    String[]
  examplesBn    String[]
  level         Levels
  category      String
  wordType      String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  relatedBy     UserWord[]
  userBookmarks UserBookmark[]
  quizQuestions QuizQuestion[]

  @@index([level])
  @@index([category])
}

model UserBookmark {
  userId       Int
  wordId       Int
  bookmarkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId, bookmarkedAt])
}

model UserWord {
  userId         Int
  wordId         Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  learningStatus LearningStatus @default(LEARNED)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId])
}

model User {
  id             Int            @id @default(autoincrement())
  name           String?
  user_name      String
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  role           Roles          @default(user)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  lastActivityAt DateTime?      @default(now())
  password       String?
  accounts       Account[]
  sessions       Session[]
  relatedWords   UserWord[]
  userBookmarks  UserBookmark[]
  quizResults    QuizResults[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model QuizType {
  id               Int            @id @default(autoincrement())
  name             String         @unique
  relatedQuestions QuizQuestion[]
  quizResults      QuizResults[]
}

enum Roles {
  user
  admin
}

enum Levels {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LearningStatus {
  LEARNED
  STILL_LEARNING
}

enum QuizMode {
  PRACTICE
  WEEKLY
  BIWEEKLY
}

enum DifficultyLevels {
  EASY
  MEDIUM
  HARD
}